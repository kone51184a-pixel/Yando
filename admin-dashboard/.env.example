# Copier en .env.local (jamais commité).
# En développement : laisser VITE_USE_EMULATORS=true, les autres valeurs peuvent rester fictives.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-vtc-bamako

# En production : remplir avec la config web du projet Firebase (Paramètres du projet → Vos applications)
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
