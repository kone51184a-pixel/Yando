{
  "name": "vtc-bamako-functions",
  "private": true,
  "description": "Cloud Functions de l'application VTC Bamako",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test lib/test/*.test.js",
    "serve": "npm run build && firebase emulators:start --project demo-vtc-bamako",
    "seed": "npm run build && node lib/src/scripts/seed.js",
    "set-admin": "npm run build && node lib/src/scripts/setAdmin.js",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "geofire-common": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
